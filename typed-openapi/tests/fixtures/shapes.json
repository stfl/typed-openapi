        },
        "closed": {
          "$ref": "#/definitions/Closed"
        },
        "al": {
          "$ref": "#/definitions/Flat"
        },
        "ei": {
          "$ref": "#/definitions/ExternalInline"
        },
        "rep": {
          "$ref": "#/definitions/ExternalRepeat"
        },
        "repn": {
          "$ref": "#/definitions/ExternalRepeatNewtype"
