{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Address": {
      "type": "object",
      "required": [
        "street",
        "city"
      ],
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        }
      }
    },
    "Point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "OpenTrue": {
      "type": "object",
      "required": [
        "a"
      ],
      "properties": {
        "a": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "OpenEmpty": {
      "type": "object",
      "required": [
        "a"
      ],
      "properties": {
        "a": {
          "type": "integer"
        }
      },
      "additionalProperties": {}
