            "z": {
              "type": "integer"
            }
          }
        }
      }
    },
    "ExternalDeep": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "a"
          ],
          "properties": {
            "a": {
              "type": "object",
              "properties": {
                "a": {
                  "$ref": "#/definitions/HasB"
